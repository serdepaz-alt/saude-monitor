# --- Front-end (públicas por natureza; a segurança vem do RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Somente servidor (Netlify > Environment variables). NUNCA commitar valores ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 32 bytes em base64:  openssl rand -base64 32
DATA_ENC_KEY=
HASH_KEY=
# Chave usada por dispositivos/integrações no header x-api-key
INGEST_API_KEY=
# E-mail (Resend) — https://resend.com
RESEND_API_KEY=
# Remetente com domínio verificado no Resend. Para testes: "Monitor de Saúde <onboarding@resend.dev>"
EMAIL_FROM=Monitor de Saúde <onboarding@resend.dev>
# URL do portal (link enviado na mensagem)
PORTAL_URL=https://seu-site.netlify.app
